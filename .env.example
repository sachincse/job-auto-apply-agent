# ============================================
# Job Auto-Apply Agent — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# --- Claude AI (OPTIONAL — agent works without it using keyword fallback) ---
# If set, enables AI-powered job scoring, cover letter generation, and message classification
# If empty, the agent uses keyword matching and templates instead
ANTHROPIC_API_KEY=

# --- Adzuna Job Search API (free tier: 250 calls/day) ---
# Sign up: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Arbeitnow (NO KEY NEEDED — free API for visa-sponsored Germany jobs) ---
# Enabled by default, no configuration required

# --- LinkedIn Credentials ---
# WARNING: Automating LinkedIn can get your account banned. Use at your own risk.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- Telegram Bot (for reports & alerts) ---
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email / SMTP (for reports) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_TO=

# --- IMAP (email reading for meeting auto-record) ---
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# --- Meeting Recording ---
RECORDING_FPS=10
MEETING_HEADLESS=true

# --- Visa-Sponsorship Job Portals (Candidate A) ---
# Tip: use Gmail plus-aliases (e.g. you+honeypot@gmail.com) so portal OTPs all
# arrive in your main inbox.
HONEYPOT_EMAIL=
HONEYPOT_PASSWORD=
OTTA_EMAIL=
OTTA_PASSWORD=
RELOCATE_EMAIL=
RELOCATE_PASSWORD=
JOBBATICAL_EMAIL=
JOBBATICAL_PASSWORD=
JOBLEADS_EMAIL=
JOBLEADS_PASSWORD=
MIIG_EMAIL=
MIIG_PASSWORD=

# --- Visa-Sponsorship Job Portals (Candidate B — second applicant in dual setup) ---
KRITIKA_HONEYPOT_EMAIL=
KRITIKA_HONEYPOT_PASSWORD=
KRITIKA_OTTA_EMAIL=
KRITIKA_OTTA_PASSWORD=
KRITIKA_IMAP_USER=
KRITIKA_IMAP_PASS=

# --- General ---
DRY_RUN=false
LOG_LEVEL=INFO
MAX_DAILY_APPLICATIONS=20
